rules_version = '2';
// 파일 저장소 규칙 — firebase.json 'storage' 로 배포한다(2026-11-08 처음 저장소에 둠).
service firebase.storage {
  match /b/{bucket}/o {
    // 운영자 — firestore.rules 의 isAdmin() 과 같은 계정
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'dark_0417@nate.com',
          'mangnae760723@gmail.com',
          'hansun440@gmail.com'
        ];
    }

    // 전자책 파일 — 받기는 로그인한 회원만(무료 책), 올리기 · 지우기는 운영자만(100MB 까지 — ebookRepository EBOOK_MAX_MB 와 같게)
    match /ebooks/{id}/{file} {
      // 무료 책(price 0)만 회원이 받는다 — 유료는 결제를 붙인 뒤 연다
      allow read: if isAdmin() || (request.auth != null
        && firestore.get(/databases/(default)/documents/ebooks/$(id)).data.get('price', 0) == 0);
      allow create, update: if isAdmin() && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // 전자책 표지 — 손님도 본다
    match /ebook-covers/{id}/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // 물건 평면도 · 현장 사진(앱 storageUpload) — 로그인한 회원
    match /floor-plans/{a}/{f} {
      allow read, write: if request.auth != null;
    }
    match /site-photos/{a}/{f} {
      allow read, write: if request.auth != null;
    }
  }
}
