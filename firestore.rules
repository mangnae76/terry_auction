rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 이 앱을 쓸 수 있는 계정 — 여기 없는 메일로 로그인하면 아무것도 읽지 못한다.
    // src/services/accessControl.ts의 ALLOWED_EMAILS와 같이 맞춰야 한다.
    // 소셜 로그인은 Worker가 발급하는 custom token의 email 클레임이 여기로 들어온다.
    // 모든 가입자에게 연다(2026-11-02) — 로그인했으면 누구나. 개인 자료는 아래 컬렉션마다 uid 로 따로 막는다.
    // 다시 3계정만 쓰게 하려면 아래 주석의 허용 목록 줄로 되돌리고, 앱 accessControl.ts 의 OPEN_TO_ALL 도 false 로.
    function isAllowedUser() {
      return request.auth != null;
      // return request.auth != null
      //   && request.auth.token.email is string
      //   && request.auth.token.email.lower() in [
      //     'dark_0417@nate.com',
      //     'mangnae760723@gmail.com',
      //     'hansun440@gmail.com'
      //   ];
    }

    // 운영자 — 공지·이벤트 글을 올릴 수 있는 계정.
    // 쓰는 계정이 여기 없으면 올리기가 규칙에서 막힌다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'dark_0417@nate.com',
          'mangnae760723@gmail.com',
          'hansun440@gmail.com'
        ];
    }

    // 공지·이벤트·업데이트 글 — 누구나 읽고, 운영자만 쓴다
    match /boardPosts/{id} {
      allow read: if isAllowedUser();
      allow write: if isAdmin();
    }

    // 전자책(콘텐츠) — 올린 책은 손님도 목록을 본다(받기는 로그인 회원만 — 파일은 Storage 규칙이 막는다).
    // 운영자만 올리고 고친다. 회원은 처음 받을 때 받은 수(downloads)만 1 올린다
    match /ebooks/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isAllowedUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
            && request.resource.data.downloads == resource.data.get('downloads', 0) + 1);
    }

    // 전자책 파일 조각 — 파일 저장소 대신 글 여러 개에 나눠 담은 책 파일. 운영자만 쓰고,
    // 회원은 올린 무료 책(price 0)의 조각만 읽는다
    match /ebookParts/{pid} {
      allow read: if isAdmin() || (isAllowedUser()
        && get(/databases/$(database)/documents/ebooks/$(resource.data.book)).data.published == true
        && get(/databases/$(database)/documents/ebooks/$(resource.data.book)).data.get('price', 0) == 0);
      allow write: if isAdmin();
    }

    // 전자책 받은 기록 — '{uid}_{책}' 하나. 내 것만 쓰고 읽는다, 운영자는 모두 읽는다
    match /ebookReceipts/{rid} {
      allow read: if isAllowedUser() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isAllowedUser()
        && request.resource.data.uid == request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.ebookId
        // 무료 책만 — 유료(price 1 이상)는 결제를 붙인 뒤 연다
        && get(/databases/$(database)/documents/ebooks/$(request.resource.data.ebookId)).data.get('price', 0) == 0;
    }

    // 오류및제안 게시판(웹 커뮤니티) — 회원이 쓰고 모두 읽는다. 내 글만 고치고 지운다, 조회수는 1씩만, 운영자는 모두 지운다
    match /suggestPosts/{id} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.views == 0
        && request.resource.data.commentCount == 0;
      allow update: if isAdmin()
        || (isAllowedUser() && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'updatedAt']))
        || (isAllowedUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1)
        || (isAllowedUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && (request.resource.data.commentCount - resource.data.commentCount) in [1, -1]);
      allow delete: if isAdmin() || (isAllowedUser() && resource.data.authorUid == request.auth.uid);

      match /comments/{cid} {
        allow read: if isAllowedUser();
        allow create: if isAllowedUser() && request.resource.data.authorUid == request.auth.uid
          && (request.resource.data.get('admin', false) == false || isAdmin());   // '운영자' 표시는 운영자만
        allow delete: if isAdmin() || (isAllowedUser() && resource.data.authorUid == request.auth.uid);
      }
    }

    // 사용자 프로필 — 본인 것만 읽고 쓸 수 있음
    match /users/{uid} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;
      // 허용 목록으로 다시 닫았을 때 — 막 가입한 사람도 제 문서의 가입 정보 · 내 정보 칸만 읽고 적는다(지금은 위 줄이 모두에게 열려 있다).
      // 무료이용 · 포인트 같은 '받는 것'은 본인이 적을 수 없게 칸 목록에서 뺐다(서비스 오픈 때 서버가 준다 — docs/서비스오픈목록.md)
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'nickname', 'createdAt',
          'realName', 'phone', 'region', 'joinPath', 'joinPathDetail', 'referralCode', 'smsOptIn', 'agreedAt',
          'emailId', 'emailDomain', 'emailOptIn', 'phone1', 'phone2', 'phone3', 'address1', 'address2',
          'bizType', 'houseCount', 'salesByYear', 'otherIncomeByYear'
        ]);

      // ===== 집 PC 수집 도우미(관리자만) — 웹 시장분석 › 경매사례에서 명령, 집 PC agent.py 가 옥션원 · 탱크옥션 수집 =====
      // (auction-web 의 규칙을 그대로 옮기고, 허용 목록 대신 운영자 + 본인으로 막는다)
      // 수집한 매각물건 — 요약 1개 + JSON 조각 여러 개
      match /datasets/{ds} {
        allow get, delete: if isAgentOwner(uid);
        allow create, update: if isAgentOwner(uid) && ds == 'main'
          && agentData().keys().hasOnly(['count', 'chunks', 'version', 'by', 'updatedAt'])
          && agentData().count is int && agentData().count >= 0 && agentData().count <= 20000
          && agentData().chunks is int && agentData().chunks >= 1 && agentData().chunks <= 400
          && agentData().version is int
          && agentData().version == (resource == null ? 0 : resource.data.version) + 1
          && agentData().by in ['web', 'agent']
          && agentData().updatedAt == request.time;

        match /chunks/{chunk} {
          allow read, delete: if isAgentOwner(uid);
          allow create, update: if isAgentOwner(uid) && ds == 'main'
            && agentData().keys().hasOnly(['i', 'data', 'v'])
            && agentData().i is int && agentData().i >= 0 && agentData().i < 400 && chunk == string(agentData().i)
            && agentData().data is string && agentData().data.size() <= 900000
            && agentData().v is int;
        }
      }
      // 웹 → 집 PC 명령 (정해진 명령 · 사이트 · 기간만)
      match /agent/control {
        allow get: if isAgentOwner(uid);
        allow create, update: if isAgentOwner(uid)
          && agentData().keys().hasOnly(['cmd', 'stop', 'webSeenAt'])
          && (!('cmd' in agentData()) || validAgentCmd(agentData().cmd))
          && (!('stop' in agentData()) || (agentData().stop is map && agentData().stop.keys().hasOnly(['id', 'at']) && agentData().stop.id is string && agentData().stop.id.size() <= 64))
          && (!('webSeenAt' in agentData()) || agentData().webSeenAt is timestamp);
      }
      // 웹 ↔ 집 PC 모을 물건 대기열 {items: [{case, addr, at}]} — 웹이 올리고, 도우미가 끝난 사건을 뺀다
      match /agent/queue {
        allow get: if isAgentOwner(uid);
        allow create, update: if isAgentOwner(uid)
          && agentData().keys().hasOnly(['items'])
          && agentData().items is list && agentData().items.size() <= 200;
      }
      // 집 PC → 웹 모은 동네 {dongs: {'인천 서구 검암동': {at, n, site, src, months}}}
      match /agent/coverage {
        allow get: if isAgentOwner(uid);
        allow create, update: if isAgentOwner(uid)
          && agentData().keys().hasOnly(['dongs'])
          && agentData().dongs is map && agentData().dongs.size() <= 3000;
      }
      // 집 PC → 웹 상태
      match /agent/status {
        allow get: if isAgentOwner(uid);
        allow create, update: if isAgentOwner(uid)
          && agentData().keys().hasOnly(['at', 'version', 'ready', 'busy', 'enriching', 'prog', 'message', 'lastCmd', 'site', 'target'])
          && (!('message' in agentData()) || (agentData().message is string && agentData().message.size() <= 2000))
          && (!('target' in agentData()) || (agentData().target is string && agentData().target.size() <= 200));
      }
    }
    function isAgentOwner(uid) {
      return isAdmin() && request.auth.uid == uid;
    }
    function agentData() {
      return request.resource.data;
    }
    function validAgentCmd(c) {
      return c is map && c.keys().hasOnly(['id', 'name', 'args', 'at'])
        && c.id is string && c.id.size() <= 64
        && c.name in ['open', 'screen', 'auto', 'enrich', 'queue']
        && c.args is map && c.args.keys().hasOnly(['site', 'months', 'src', 'fresh'])
        && (!('site' in c.args) || c.args.site in ['옥션원', '탱크옥션'])
        && (!('months' in c.args) || c.args.months in [0, 6, 12, 24, 36])
        && (!('src' in c.args) || c.args.src in ['near', 'same'])
        && (!('fresh' in c.args) || c.args.fresh is bool);
    }

    // 사용자별 앱 설정·임장경로 draft·즐겨찾기 등
    match /userPrefs/{uid} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;
    }

    // ===== 공용 수집 자료(경매사례) — 관리자 누구든 집 PC 도우미로 쌓으면 다 같이 쓴다. 계정마다 쌓지 않는다 =====
    // (GitHub Actions 로 쌓는 자료와 같은 공용 자료. 명령 · 상태 · 대기열은 각자 집 PC 라 users/{uid}/agent 에 그대로)
    match /saleData/main {
      allow read: if isAllowedUser();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && agentData().keys().hasOnly(['count', 'chunks', 'version', 'by', 'updatedAt'])
        && agentData().count is int && agentData().count >= 0 && agentData().count <= 20000
        && agentData().chunks is int && agentData().chunks >= 1 && agentData().chunks <= 400
        && agentData().version is int
        && agentData().version == (resource == null ? 0 : resource.data.version) + 1
        && agentData().by in ['web', 'agent']
        && agentData().updatedAt == request.time;
      match /chunks/{chunk} {
        allow read: if isAllowedUser();
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
          && agentData().keys().hasOnly(['i', 'data', 'v'])
          && agentData().i is int && agentData().i >= 0 && agentData().i < 400 && chunk == string(agentData().i)
          && agentData().data is string && agentData().data.size() <= 900000
          && agentData().v is int;
      }
    }
    // 집 PC 도우미 상태 · 명령 · 대기열 — 공용(관리자 누구나 같은 도우미). 예전 users/{uid}/agent/… 와 같은 검사
    match /saleData/agentStatus {
      allow get: if isAdmin();
      allow create, update: if isAdmin()
        && agentData().keys().hasOnly(['at', 'version', 'ready', 'busy', 'enriching', 'prog', 'message', 'lastCmd', 'site', 'target'])
        && (!('message' in agentData()) || (agentData().message is string && agentData().message.size() <= 2000))
        // target — 지금 받는 곳(읍면동 · 사건), 웹 진행 막대 위에 보인다(agent 2026.11.08)
        && (!('target' in agentData()) || (agentData().target is string && agentData().target.size() <= 200));
    }
    match /saleData/agentControl {
      allow get: if isAdmin();
      allow create, update: if isAdmin()
        && agentData().keys().hasOnly(['cmd', 'stop', 'webSeenAt'])
        && (!('cmd' in agentData()) || validAgentCmd(agentData().cmd))
        && (!('stop' in agentData()) || (agentData().stop is map && agentData().stop.keys().hasOnly(['id', 'at']) && agentData().stop.id is string && agentData().stop.id.size() <= 64))
        && (!('webSeenAt' in agentData()) || agentData().webSeenAt is timestamp);
    }
    match /saleData/agentQueue {
      allow get: if isAdmin();
      allow create, update: if isAdmin()
        && agentData().keys().hasOnly(['items'])
        && agentData().items is list && agentData().items.size() <= 200;
    }
    match /saleData/coverage {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin()
        && agentData().keys().hasOnly(['dongs'])
        && agentData().dongs is map && agentData().dongs.size() <= 3000;
    }

    // 점검 모드 · 시작 팝업 — 로그인 전 화면에도 띄워야 해서 누구나 읽고, 운영자만 고친다(운영 › 점검 모드 · 앱 시작 팝업)
    match /siteConfig/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'main'
        && request.resource.data.keys().hasOnly(['maintenance', 'popup', 'updatedAt', 'updatedBy'])
        && request.resource.data.maintenance is map && request.resource.data.maintenance.keys().hasOnly(['on', 'message', 'until'])
        && request.resource.data.maintenance.message is string && request.resource.data.maintenance.message.size() <= 500
        && request.resource.data.popup is map && request.resource.data.popup.keys().hasOnly(['on', 'title', 'body', 'linkUrl', 'startAt', 'endAt', 'version'])
        && request.resource.data.popup.title is string && request.resource.data.popup.title.size() <= 60
        && request.resource.data.popup.body is string && request.resource.data.popup.body.size() <= 500;
    }

    // 1:1 문의 · 정보 오류 제보 — 회원은 제 글만 쓰고 보고, 답변대기일 때만 지운다. 답은 운영자만 단다(운영 › 문의함 · 제보 처리)
    match /inquiries/{id} {
      allow read: if isAdmin() || (isAllowedUser() && resource.data.uid == request.auth.uid);
      allow create: if isAllowedUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nickname', 'kind', 'title', 'body', 'caseNumber', 'status', 'createdAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.kind in ['이용문의', '결제문의', '오류신고', '정보오류제보', '제휴문의', '기타']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
        && request.resource.data.caseNumber is string && request.resource.data.caseNumber.size() <= 40;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'answeredAt', 'answeredBy'])
        && request.resource.data.status == 'answered'
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 2000;
      allow delete: if isAdmin() || (isAllowedUser() && resource.data.uid == request.auth.uid && resource.data.status == 'open');
    }

    // 회원탈퇴 신청 — 본인은 신청 · (처리 전) 취소만, 목록을 보고 처리하는 건 운영자
    match /withdrawRequests/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list, update: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nickname', 'reason', 'status', 'requestedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'requested'
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid && resource.data.status == 'requested');
    }

    // 경매 물건 — 본인이 소유한(uid 일치) 문서만 접근
    match /auctions/{auctionId} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }

    // 현장사진 — 장당 1문서(dataUrl은 압축된 base64). 본인 uid 일치 시에만 접근
    match /auctionPhotos/{photoId} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }

    // 사진 용량 누계 — 문서 ID가 곧 uid
    match /photoUsage/{uid} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;
    }

    // 임장 동선 저장
    match /fieldTrips/{planId} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }

    // 자금관리 4개 컬렉션 — 본인 uid 일치 시에만 접근
    match /financeCashFlows/{id} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }
    match /financeBusinessExpenses/{id} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }
    match /financeFuelMeal/{id} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }
    match /financeItemPurchases/{id} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }

    // 인테리어 비용 — 낙찰이후 인테리어 탭 전용 (자금관리와 자리를 나눈다)
    match /interiorExpenses/{id} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }

    // 대문(로그인 전 화면) 숫자 — 모아 둔 실거래 건수 · 단지 수 합 한 장. 누구나 읽고, 로그인한 사용자가 적는다(services/landingStats)
    match /publicStats/{id} {
      allow read: if true;
      allow write: if isAllowedUser();
    }
    // 시군구마다의 건수 · 단지 수 — 위 합을 다시 셀 때 쓴다
    match /publicStatsD/{id} {
      allow read, write: if isAllowedUser();
    }

    // 공공데이터 조회 결과 모아 두기 — 지역·단지 단위라 모든 사용자가 같이 쓴다.
    // 개인 자료가 아니고, 누가 먼저 열든 같은 값이라 로그인한 사용자면 읽고 쓸 수 있다.
    match /cacheDongTrades/{id} {
      allow read, write: if isAllowedUser();
    }
    match /cachePlaceHistory/{id} {
      allow read, write: if isAllowedUser();
    }
    // 시군구 4년치 — 1MB 를 넘어 조각(id#0 …)으로 나눠 적는다
    match /cachePlaceHistoryV2/{id} {
      allow read, write: if isAllowedUser();
    }
    match /cacheDongUnits/{id} {
      allow read, write: if isAllowedUser();
    }
    // 동 하나의 세대수 세 종류(연립·다세대 · 아파트 · 오피스텔) 한 벌 — 웹 수요분석
    match /cacheDongUnitsAll/{id} {
      allow read, write: if isAllowedUser();
    }
    // 필지 하나의 건축물대장 주차대수 · 승강기 수 — 개별성 분석
    match /cacheBldFacts/{id} {
      allow read, write: if isAllowedUser();
    }
    // 달 단위 실거래 — 지역·종류·달이 같으면 값이 같아 모두가 나눠 쓴다
    match /cacheTradeMonth/{id} {
      allow read, write: if isAllowedUser();
    }
    // 공동주택 공시가격 — 호실 단위. 연 1회 공시라 한 번 받으면 오래 쓴다
    match /cacheAptPrice/{id} {
      allow read, write: if isAllowedUser();
    }

    // 관리자 도구 · 경매지번 분석 스냅샷 — 본인 uid 일치 시에만.
    // 그때 본 숫자를 그대로 박제해 두는 자리다 (거래 표는 담지 않는다).
    match /adminSnapshots/{id} {
      allow read, update, delete:
        if isAllowedUser() && resource.data.uid == request.auth.uid;
      allow create:
        if isAllowedUser() && request.resource.data.uid == request.auth.uid;
    }

    // 그 외 컬렉션은 명시적 허용 없이는 거부 (기본 deny)
  }
}
