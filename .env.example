VITE_PUBLIC_DATA_API_KEY=YOUR_DATA_GO_KR_KEY
VITE_ENABLE_LIVE_API=true
# Cloudflare Worker proxy origin (프로덕션/Capacitor 빌드에서 /api-* 호출 prefix).
# Dev(`npm run dev`)에서는 무시되고 Vite proxy 사용.
# 예: https://terry-auction-proxy.<account>.workers.dev
VITE_API_BASE=
# 네이버 부동산 비공식 /api/articles 스크래핑 (dev 프록시 /api-naver-land 경유)
VITE_ENABLE_NAVER_LAND=true
VITE_ENABLE_MOLIT_API=true
VITE_ENABLE_MOLIT_RENT_API=false
VITE_ENABLE_OFFICETEL_TRADE_API=false
VITE_ENABLE_OFFICETEL_RENT_API=false
VITE_ENABLE_VILLA_TRADE_API=false
VITE_ENABLE_VILLA_RENT_API=false
VITE_ENABLE_SINGLE_TRADE_API=false
VITE_ENABLE_SINGLE_RENT_API=false
VITE_ENABLE_COMMERCIAL_TRADE_API=false
VITE_ENABLE_ONBID_API=false
VITE_ENABLE_LAND_PRICE_API=true
VITE_MOLIT_APT_API_PATH=/1613000/RTMSDataSvcAptTradeDev/getRTMSDataSvcAptTradeDev
VITE_MOLIT_APT_RENT_API_PATH=/1613000/RTMSDataSvcAptRent/getRTMSDataSvcAptRent
VITE_MOLIT_OFFICETEL_TRADE_API_PATH=/1613000/RTMSDataSvcOffiTrade/getRTMSDataSvcOffiTrade
VITE_MOLIT_OFFICETEL_RENT_API_PATH=/1613000/RTMSDataSvcOffiRent/getRTMSDataSvcOffiRent
VITE_MOLIT_VILLA_TRADE_API_PATH=/1613000/RTMSDataSvcRHTrade/getRTMSDataSvcRHTrade
VITE_MOLIT_VILLA_RENT_API_PATH=/1613000/RTMSDataSvcRHRent/getRTMSDataSvcRHRent
VITE_MOLIT_SINGLE_TRADE_API_PATH=/1613000/RTMSDataSvcSHTrade/getRTMSDataSvcSHTrade
VITE_MOLIT_SINGLE_RENT_API_PATH=/1613000/RTMSDataSvcSHRent/getRTMSDataSvcSHRent
VITE_MOLIT_COMMERCIAL_TRADE_API_PATH=/1613000/RTMSDataSvcNrgTrade/getRTMSDataSvcNrgTrade
VITE_MOLIT_LAND_API_PATH=/1611000/nsdi/ReferLandPriceService/attr/getReferLandPriceAttr
VITE_ONBID_API_PATH=/1160100/service/GetBondInfoService/getBondResultInfo
VITE_ONBID_FALLBACK_PATH=/openapi/services/ThingInfoInquireSvc/getUnifyUsageCltr
VITE_GEOCODE_BASE_URL=/api-geo
VITE_KAKAO_GEOCODE_BASE_URL=/api-kakao
VITE_KAKAO_REST_API_KEY=
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# === 소셜 로그인 (선택) ===
# 비워두면 LoginPage/SignupPage에 해당 버튼이 표시되지 않음.
# 카카오 — developers.kakao.com → 앱 추가 → REST API 키 발급
VITE_KAKAO_LOGIN_REST_API_KEY=
# 네이버 — developers.naver.com → 애플리케이션 등록 → Client ID/Secret 발급
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CLIENT_SECRET=
